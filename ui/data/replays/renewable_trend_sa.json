    "renewable_share_pct"
   ],
   "truncated": false,
   "sql": "SELECT DATE_TRUNC('DAY', day) AS day__day, day AS day, network_region AS network_region, 100.0 * SUM(CASE WHEN is_renewable THEN energy_mwh ELSE 0 END) / NULLIF(SUM(energy_mwh), 0) AS renewable_share_pct FROM generation_with_group WHERE day >= CAST('2026-09-19' AS TIMESTAMP) AND day < CAST('2026-10-19' AS TIMESTAMP) AND network_region = 'SA1' GROUP BY 1, 2, 3 ORDER BY 1 ASC"
  },
