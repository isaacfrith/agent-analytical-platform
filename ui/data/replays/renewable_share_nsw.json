   "truncated": false,
   "sql": "SELECT DATE_TRUNC('day', day) AS day__day, network_region AS network_region, SUM(CASE WHEN is_renewable THEN energy_mwh ELSE 0 END) AS renewable_energy, SUM(energy_mwh) AS total_energy FROM generation_with_group WHERE network_region = 'NSW1' GROUP BY 1, 2 ORDER BY 1"
  },
