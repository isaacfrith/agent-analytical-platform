# Copy to terraform.tfvars (gitignored) and fill in your values:
#   cp terraform.tfvars.example terraform.tfvars

# One region for everything: bucket, Bedrock model access, inference profiles.
# e.g. "us-east-1", "eu-west-1", "ap-southeast-2"
aws_region = "<your-region>"

# Set ONLY if you use a named admin profile in ~/.aws/credentials.
# Leave unset to use env vars / the default profile.
# aws_profile = "default"

# Globally unique across all AWS accounts. Add a suffix you own.
# e.g. "agent-analytics-dev-isaac"
bucket_name = "agent-analytics-dev-<your-suffix>"

# Optional — defaults to "agent-analytics-dev".
# iam_user_name = "agent-analytics-dev"

# --- Live questions ---------------------------------------------------------
# Required: where AWS Budgets emails spend alerts.
budget_email = "you@example.com"

# Your fork: the GitHub Pages origin (no path), the repo the server clones, and
# your Cloudflare Turnstile site key (public; the secret goes in SSM, not here).
# The defaults point at the original repo, so a fork must set all three.
# site_origin        = "https://<you>.github.io"
# repo_url           = "https://github.com/<you>/agent-analytical-platform.git"
# turnstile_site_key = "0x..."

# Optional (defaults shown in variables.tf):
# budget_limit_usd   = 20
# live_instance_type = "t3a.large"   # x86_64 only: WrenAI's engine has no ARM Linux wheel
# bedrock_model_id   = "au.anthropic.claude-haiku-4-5-20251001-v1:0"
