.env
.venv
__pycache__/
.ruff_cache/
.pytest_cache/
dist/
evaluations/last_run.md
evaluations/*.log

# Terraform — state must never be committed (it is plaintext and would hold
# secrets if we ever let it). The lock file (.terraform.lock.hcl) IS committed,
# like uv.lock.
.terraform/
terraform.tfstate*
terraform.tfvars
*.tfplan

# Terraform build artifacts (the Lambda zip)
terraform/.build/
