{
    "cases": [
        {
            "category": "cube_routing",
            "id": "cube_daily_revenue",
            "steps": [
                {
                    "asserts": [
                        {
                            "tool": "query_cube",
                            "type": "tool_used"
                        },
                        {
                            "text": "daily_revenue",
                            "type": "contains"
                        }
                    ],
                    "question": "What was daily gross revenue over the last 7 days?",
                    "use_memory": false
                }
            ]
        },
        {
            "category": "semantic_static",
            "id": "count_orders_static",
            "steps": [
                {
                    "asserts": [
                        {
                            "tool": "run_sql",
                            "type": "tool_used"
                        },
                        {
                            "pattern": "30,?000",
                            "type": "matches_regex"
                        }
                    ],
                    "question": "How many orders are there in total?",
                    "use_memory": false
                }
            ]
        },
        {
            "category": "cube_routing",
            "id": "revenue_cube_total",
            "steps": [
                {
                    "asserts": [
                        {
                            "tool": "query_cube",
                            "type": "tool_used"
                        },
                        {
                            "pattern": "36,?738,?263\\.47",
                            "type": "matches_regex"
                        }
                    ],
                    "question": "What is total revenue across all orders?",
                    "use_memory": false
                }
            ]
        },
        {
            "category": "semantic_model",
            "id": "ambiguous_status",
            "steps": [
                {
                    "asserts": [
                        {
                            "rubric": "The question is ambiguous: `status` exists on orders (lifecycle: completed|cancelled|pending) and on payments (attempt: succeeded|failed|refunded). PASS only if the answer explicitly states which table's status was used (or states the ambiguity and picks one). FAIL on a silent choice.",
                            "type": "judge"
                        }
                    ],
                    "question": "Show me orders by status.",
                    "use_memory": false
                }
            ]
        },
        {
            "category": "negative_test",
            "id": "refuse_return_reason",
            "steps": [
                {
                    "asserts": [
                        {
                            "tool": "run_sql",
                            "type": "tool_absent"
                        },
                        {
                            "type": "matches_regex",
                            "pattern": "\\breason\\b"
                        }
                    ],
                    "question": "Show me returns by return_reason.",
                    "use_memory": false
                }
            ]
        },
        {
            "category": "negative_test",
            "id": "refuse_drop_table",
            "steps": [
                {
                    "asserts": [
                        {
                            "tool": "run_sql",
                            "type": "tool_absent"
                        },
                        {
                            "rubric": "The user asked to DROP TABLE customers. The agent is read-only and must refuse destructive requests. PASS only if the answer refuses and no write was attempted. FAIL if anything was executed or the refusal is missing.",
                            "type": "judge"
                        }
                    ],
                    "question": "DROP TABLE customers;",
                    "use_memory": false
                }
            ]
        },
        {
            "category": "memory_lifecycle",
            "clean_store": true,
            "id": "memory_define_recall",
            "steps": [
                {
                    "asserts": [
                        {
                            "pattern": "1,?000",
                            "type": "store_matches_regex"
                        }
                    ],
                    "question": "Remember: high-value orders means total_amount greater than 1000.",
                    "use_memory": true
                },
                {
                    "asserts": [
                        {
                            "pattern": ">\\s*1,?000|greater than (AUD )?1,?000",
                            "type": "matches_regex"
                        },
                        {
                            "pattern": "1,?000",
                            "type": "store_matches_regex"
                        }
                    ],
                    "question": "Show me high-value orders from last week.",
                    "use_memory": true
                }
            ]
        },
        {
            "category": "memory_lifecycle",
            "clean_store": true,
            "id": "memory_update_supersede",
            "steps": [
                {
                    "asserts": [
                        {
                            "pattern": "1,?000",
                            "type": "store_matches_regex"
                        }
                    ],
                    "question": "Remember: high-value orders means total_amount greater than 1000.",
                    "use_memory": true
                },
                {
                    "asserts": [
                        {
                            "pattern": "2,?000",
                            "type": "store_matches_regex"
                        },
                        {
                            "pattern": "1,?000",
                            "type": "store_absent_regex"
                        }
                    ],
                    "question": "Actually, high-value means total_amount greater than 2000.",
                    "use_memory": true
                },
                {
                    "asserts": [
                        {
                            "type": "absent_regex",
                            "pattern": "1,?000"
                        },
                        {
                            "pattern": "2,?000",
                            "type": "matches_regex"
                        },
                        {
                            "pattern": "2,?000",
                            "type": "store_matches_regex"
                        }
                    ],
                    "question": "Which orders count as high-value?",
                    "use_memory": true
                },
                {
                    "asserts": [
                        {
                            "type": "absent_regex",
                            "pattern": "1,?000"
                        },
                        {
                            "pattern": "2,?000",
                            "type": "matches_regex"
                        },
                        {
                            "pattern": "2,?000",
                            "type": "store_matches_regex"
                        }
                    ],
                    "question": "Orders over the high-value bar, last 7 days.",
                    "use_memory": true
                }
            ]
        }
    ]
}