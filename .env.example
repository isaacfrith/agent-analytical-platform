# Copy to .env (gitignored) and fill in. Secrets never go here — AWS key
# material lives in ~/.aws/credentials under AWS_PROFILE.
AWS_PROFILE=agent-analytics-dev
AWS_REGION=<your-region>
AWS_S3_BUCKET=<your-bucket-name>
BEDROCK_MODEL_ID=<inference-profile-id>
LAKEKEEPER_URI=http://localhost:8181
ICEBERG_WAREHOUSE=dev_lakehouse
LAKEKEEPER_STS_ROLE_ARN=<from: terraform output -raw lakekeeper_vending_role_arn>
OPENELECTRICITY_API_KEY=<from: platform.openelectricity.org.au>
