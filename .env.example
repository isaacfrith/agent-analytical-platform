# Agent Analytical Platform Configuration
# Copy to .env and fill in your values. All AWS_* variables are required.

# === AWS Credentials (REQUIRED) ===
AWS_PROFILE=your-aws-profile
AWS_REGION=ap-southeast-2
BEDROCK_MODEL_ID=au.anthropic.claude-3-5-sonnet-20241022-v2:0
AWS_S3_BUCKET=your-s3-bucket-name

# === Agent Configuration (Optional: defaults shown) ===
# AGENT_TURNS_BUDGET=10
# AGENT_TOKENS_BUDGET=150000

# === Memory Configuration (Optional: defaults shown) ===
# MEMORY_VALKEY_URL=redis://localhost:6379
# MEMORY_COLLECTION_NAME=agent_memories

# === External APIs ===
OPENELECTRICITY_API_KEY=your-api-key

# === Data Infrastructure ===
LAKEKEEPER_URI=http://localhost:8181
ICEBERG_WAREHOUSE=dev_lakehouse
LAKEKEEPER_STS_ROLE_ARN=arn:aws:iam::YOUR-ACCOUNT:role/agent-analytics-lakekeeper-vending

# === Development ===
CLAUDE_CODE_NO_FLICKER=1
